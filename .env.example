# 本地运行：ws://127.0.0.1:3001
# docker compose 部署（同网络访问 llonebot 服务）：ws://llonebot:3001
ONEBOT_WS_URL=ws://llonebot:3001
ONEBOT_ACCESS_TOKEN=MySecret123
BIRTHDAY_XLSX_PATH=birthdays.xlsx
BIRTHDAY_DEFAULT_GROUP_ID=123456789
BIRTHDAY_CHECK_CRON=5 0 * * *
BIRTHDAY_MESSAGE_TEMPLATE={name}同学，生日小助手提醒您生日快乐呀！
